<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VidHub.WinUI.UserControls.Modals.ThumbnailCustomizationUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VidHub.WinUI.UserControls.Modals"
    xmlns:converter="using:VidHub.WinUI.Converters"
    xmlns:viewmodel="using:VidHub.ViewModels.Modals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converter:ChangeNumberToPercentage x:Key="PercentageNumber" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewmodel:ThumbnailCustomizationViewModel />
    </UserControl.DataContext>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="fixed_position" Content="Fixed Position" Margin="0 5 5 5" HorizontalAlignment="Stretch" Grid.Column="0" />
            <ToggleButton x:Name="relative_position" Content="Relative Position" Margin="5 5 0 5" HorizontalAlignment="Stretch" Grid.Column="1" />
        </Grid>

        <Grid Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Margin="0 5 0 5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xf167;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="10 10 10 5" Grid.Row="0" Grid.Column="0" />
                <TextBlock Text="Previously extracted thumbnails will not be changed." IsTextSelectionEnabled="True" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 10 0" Grid.Row="0" Grid.Column="1" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Remove thumbnails" ToolTipService.ToolTip="Removing all extracted thumbnails will delete the images. Thumbnails must be extracted again to be displayed." Margin="10 5 5 10" HorizontalAlignment="Stretch" Grid.Column="0" />
                <Button Content="Extract thumbnails" ToolTipService.ToolTip="Extracting thumbnails again may take some time and does not affect any other previously cached videos." Margin="5 5 10 10" HorizontalAlignment="Stretch" Grid.Column="1" />
            </Grid>
        </Grid>

        <Grid Visibility="{Binding ElementName=fixed_position, Path=IsChecked}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <NumberBox Header="hour" Minimum="0" Maximum="24" SmallChange="1" Margin="5" Grid.Column="0" />
            <NumberBox Header="minute" Minimum="0" Maximum="60" SmallChange="1" Margin="5" Grid.Column="1" />
            <NumberBox Header="second" Minimum="0" Maximum="60" SmallChange="1" Margin="5" Grid.Column="2" />
            <NumberBox Header="millisecond" Minimum="0" Maximum="1000" SmallChange="1" Margin="5" Grid.Column="3" />
        </Grid>

        <Slider Header="Select relative position of thumbnail based on the entire video duration" ThumbToolTipValueConverter="{StaticResource PercentageNumber}" Minimum="0" Maximum="100" Value="50" StepFrequency="1" TickFrequency="10" TickPlacement="Outside" Visibility="{Binding ElementName=relative_position, Path=IsChecked}" />

        <ToggleSwitch Header="{x:Null}" OnContent="Use embedded thumbnail when available" OffContent="Do not use embedded thumbnail" Margin="0 5 0 0" />
    </StackPanel>
</UserControl>
