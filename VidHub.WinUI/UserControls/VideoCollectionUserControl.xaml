<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VidHub.WinUI.UserControls.VideoCollectionUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VidHub.WinUI.UserControls"
    xmlns:converter="using:VidHub.WinUI.Converters"
    xmlns:viewmodel="using:VidHub.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converter:DateFormatConverter x:Key="FormatDate" />
        <converter:DurationFormatConverter x:Key="FormatDuration" />
        <converter:SeverityTypeConverter x:Key="TransformSeverityType" />
        <converter:VideoStateIconConverter x:Key="FormatStateIcon" />
        <converter:VideoStateColorConverter x:Key="FormatStateColor" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewmodel:VideoCollectionViewModel />
    </UserControl.DataContext>

    <Grid AllowDrop="True" DragOver="DragOverItems" Drop="DropItems">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <ItemsControl x:Name="videocollection" ItemsSource="{Binding Videos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open" Command="{Binding ElementName=videocollection, Path=DataContext.OpenCommand}" CommandParameter="{Binding}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xe786;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Open in File Explorer" Command="{Binding ElementName=videocollection, Path=DataContext.OpenFileExplorerCommand}" CommandParameter="{Binding}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xec50;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Rename" Command="{Binding ElementName=videocollection, Path=DataContext.RenameCommand}" CommandParameter="{Binding}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xe8ac;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy Video File" Command="{Binding ElementName=videocollection, Path=DataContext.CopyFileCommand}" CommandParameter="{Binding}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xe8c8;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy File Path" Command="{Binding ElementName=videocollection, Path=DataContext.CopyFilePathCommand}" CommandParameter="{Binding}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xe756;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy Thumbnail" Command="{Binding ElementName=videocollection, Path=DataContext.CopyPreviewImageCommand}" CommandParameter="{Binding}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xe91b;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Remove" Command="{Binding ElementName=videocollection, Path=DataContext.RemoveVideoCommand}" CommandParameter="{Binding}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xe74d;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Grid Width="{Binding ElementName=videocollection, Path=DataContext.PreviewWidth}" Height="{Binding ElementName=videocollection, Path=DataContext.PreviewHeight}" Grid.Row="0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <Border BorderThickness="0" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding PreviewImagePath}" Stretch="Uniform" DoubleTapped="OpenVideo" />
                                    </Border>
                                    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="{Binding ElementName=videocollection, Path=DataContext.ShowDurations}" Opacity="0.8" BorderThickness="0" CornerRadius="10" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                                        <TextBlock Text="{Binding Duration, Converter={StaticResource FormatDuration}}" IsTextSelectionEnabled="True" FontFamily="Consolas" Margin="6 2" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="TextTrimmingChanged" Visibility="{Binding ElementName=videocollection, Path=DataContext.ShowTitles}" IsTextSelectionEnabled="True" Margin="10 5 10 0" Grid.Row="1" />
                            <Grid Visibility="{Binding ElementName=videocollection, Path=DataContext.ShowDates}" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="{Binding Condition.VideoState, Converter={StaticResource FormatStateIcon}}" Foreground="{Binding Condition.VideoState, Converter={StaticResource FormatStateColor}}" ToolTipService.ToolTip="{Binding Condition.Description}" FontFamily="Segoe Fluent Icons" Margin="10 5 5 0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" />
                                <TextBlock Text="{Binding Date, Converter={StaticResource FormatDate}}" IsTextSelectionEnabled="True" FontStyle="Italic" Margin="5 5 10 0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ItemsControl ItemsSource="{Binding Notifications}" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <InfoBar IsOpen="{Binding DisplayNotification}" Title="{Binding Title}" Message="{Binding Message}" Severity="{Binding Severity, Converter={StaticResource TransformSeverityType}}" IsClosable="{Binding IsClosable}">
                        <InfoBar.ActionButton>
                            <Button Content="{Binding Button.Text}" ToolTipService.ToolTip="{Binding Button.Description}" Command="{Binding Button.Command}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</UserControl>
